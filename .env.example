# Own It & Drive It - Environment Configuration
# Copy this file to .env and update the values.

APP_NAME="Own It & Drive It"
APP_VERSION="1.1.0"
DEBUG_MODE=true

SITE_NAME="Own It & Drive It"
SITE_LOCATION="Nairobi, Kenya"
SITE_URL="http://localhost:3000/"

# Database Configuration (MySQL)
DB_HOST="localhost"
DB_PORT="3307"
DB_NAME="OWNIT_DRIVEIT"
DB_USER="root"
DB_PASS=""

# Auth
# Generate admin hash: php -r "echo password_hash('your_password', PASSWORD_DEFAULT);"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="replace_with_password_hash"

# Contact
CONTACT_EMAIL="info@ownitdriveit.co.ke"
NOREPLY_EMAIL="noreply@ownitdriveit.co.ke"
MAIL_FROM="noreply@ownitdriveit.co.ke"
MAIL_ENABLED=false

# Uploads
UPLOAD_MAX_BYTES=5242880

SESSION_TIMEOUT=7200
